From 1dea305f8eda9ea0d4ef56c2a8546df1644c062e Mon Sep 17 00:00:00 2001
From: Nathan Chancellor <nathan@kernel.org>
Date: Thu, 22 Oct 2026 17:43:10 -0700
Subject: [PATCH 5/9] WIP: arm64: Use '-fint64-is-long-long' in CC_FLAGS_FPU
 when available

The kernel defines 'int64_t' and 'uint64_t' as 'long long' and
'unsigned long long' respectively, which clashes with the definition
that arm64 uses for userspace, which can cause breakage if the compiler
is unaware of it, like when including arm_neon.h within the kernel.
This was the catalyst for commit 0738c8b5915c ("arm64/neon: Disable
-Wincompatible-pointer-types when building with Clang") and a recent
LLVM change [1] introduced another error from this mismatch.

  In file included from lib/crc/crc64-neon.c:7:
  In file included from arch/arm64/include/asm/neon-intrinsics.h:33:
  In file included from /llvm_prefix/lib/clang/24/include/arm_neon.h:36:
  /llvm_prefix/lib/clang/24/include/arm_vector_types.h:61:66: error: conflicting types for '__arm_set_fpm_lscale'
     61 | __inline__ fpm_t __attribute__((__always_inline__, __nodebug__)) __arm_set_fpm_lscale(fpm_t __fpm, uint64_t __scale);
        |                                                                  ^
  /llvm_prefix/lib/clang/24/include/arm_vector_types.h:61:66: note: '__arm_set_fpm_lscale' is a builtin with type 'unsigned long (unsigned long, unsigned long)'
  /llvm_prefix/lib/clang/24/include/arm_vector_types.h:62:66: error: conflicting types for '__arm_set_fpm_nscale'
     62 | __inline__ fpm_t __attribute__((__always_inline__, __nodebug__)) __arm_set_fpm_nscale(fpm_t __fpm, int64_t __scale);
        |                                                                  ^
  /llvm_prefix/lib/clang/24/include/arm_vector_types.h:62:66: note: '__arm_set_fpm_nscale' is a builtin with type 'unsigned long (unsigned long, long)'
  /llvm_prefix/lib/clang/24/include/arm_vector_types.h:63:67: error: conflicting types for '__arm_set_fpm_lscale2'
     63 | __inline__ fpm_t __attribute__((__always_inline__, __nodebug__))  __arm_set_fpm_lscale2(fpm_t __fpm, uint64_t __scale);
        |                                                                   ^
  /llvm_prefix/lib/clang/24/include/arm_vector_types.h:63:67: note: '__arm_set_fpm_lscale2' is a builtin with type 'unsigned long (unsigned long, unsigned long)'

Use the newly introduced '-fint64-is-long-long' [2], which defines
__INT64_TYPE__ and __UINT64_TYPE__ to the kernel compatible types and
sets up clang properly internally for this switch, clearing up this
mismatch. Stop disabling '-Wincompatible-pointer-types' when this flag
is supported, as there are no more mismatches.

Cc: stable@vger.kernel.org
Closes: https://github.com/ClangBuiltLinux/linux/issues/2185
Link: https://github.com/llvm/llvm-project/commit/22287cb048390352d95d8a4925dfb9f96835444d [1]
Link: https://github.com/llvm/llvm-project/pull/234780 [2]
Signed-off-by: Nathan Chancellor <nathan@kernel.org>
---
 arch/arm64/Makefile                      |  3 +++
 arch/arm64/include/asm/neon-intrinsics.h | 13 ++++++++-----
 init/Kconfig                             |  7 +++++++
 3 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index 6b005c8fef70..126aae6c6da0 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -38,6 +38,9 @@ endif
 CC_FLAGS_FPU	:= -ffreestanding
 # Enable <arm_neon.h>
 CC_FLAGS_FPU	+= -isystem $(shell $(CC) -print-file-name=include)
+# Notify clang about the kernel's choice of int64_t being "long long" vs. just
+# "long" in userland
+CC_FLAGS_FPU	+= $(CONFIG_CC_OPT_INT64_IS_LONG_LONG)
 CC_FLAGS_NO_FPU	:= -mgeneral-regs-only
 
 KBUILD_CFLAGS	+= $(CC_FLAGS_NO_FPU) \
diff --git a/arch/arm64/include/asm/neon-intrinsics.h b/arch/arm64/include/asm/neon-intrinsics.h
index 5f13505d39fc..f5c55ab02b68 100644
--- a/arch/arm64/include/asm/neon-intrinsics.h
+++ b/arch/arm64/include/asm/neon-intrinsics.h
@@ -11,9 +11,11 @@
 /*
  * In the kernel, u64/s64 are [un]signed long long, not [un]signed long.
  * So by redefining these macros to the former, we can force gcc-stdint.h
- * to define uint64_t / in64_t in a compatible manner.
+ * to define uint64_t / in64_t in a compatible manner. clang's flag does
+ * this internally.
  */
 
+#ifndef CONFIG_CC_HAS_OPT_INT64_IS_LONG_LONG
 #ifdef __INT64_TYPE__
 #undef __INT64_TYPE__
 #define __INT64_TYPE__		long long
@@ -24,6 +26,11 @@
 #define __UINT64_TYPE__		unsigned long long
 #endif
 
+#ifdef CONFIG_CC_IS_CLANG
+#pragma clang diagnostic ignored "-Wincompatible-pointer-types"
+#endif
+#endif
+
 /*
  * genksyms chokes on the ARM NEON instrinsics system header, but we
  * don't export anything it defines anyway, so just disregard when
@@ -33,8 +40,4 @@
 #include <arm_neon.h>
 #endif
 
-#ifdef CONFIG_CC_IS_CLANG
-#pragma clang diagnostic ignored "-Wincompatible-pointer-types"
-#endif
-
 #endif /* __ASM_NEON_INTRINSICS_H */
diff --git a/init/Kconfig b/init/Kconfig
index 1858e55bfd7c..bf565abbeb84 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -147,6 +147,13 @@ config CC_OPT_INLINE_MEMSET
 	default "-finline-stringops=memset" if $(cc-option,-finline-stringops=memset)
 	default "-mllvm -max-store-memset=4294967294" if $(cc-option,-mllvm -max-store-memset=4294967294)
 
+config CC_HAS_OPT_INT64_IS_LONG_LONG
+	def_bool $(cc-option,-fint64-is-long-long)
+
+config CC_OPT_INT64_IS_LONG_LONG
+	string
+	default "-fint64-is-long-long" if CC_HAS_OPT_INT64_IS_LONG_LONG
+
 config LD_CAN_USE_KEEP_IN_OVERLAY
 	# ld.lld prior to 21.0.0 did not support KEEP within an overlay description
 	# https://github.com/llvm/llvm-project/pull/130661
-- 
2.56.0

