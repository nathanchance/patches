From cc6ccabf62fa9e16cf00612aad97e646e58a416d Mon Sep 17 00:00:00 2001
From: Nathan Chancellor <nathan@kernel.org>
Date: Fri, 30 Oct 2026 12:16:02 -0700
Subject: [PATCH 18/20] HACK: LLVM-MAIN: arm64: Temporarily detach xor-neon.o
 from the build

Link: https://github.com/ClangBuiltLinux/linux/issues/2185
Signed-off-by: Nathan Chancellor <nathan@kernel.org>
---
 arch/arm64/include/asm/xor.h | 10 ++++------
 arch/arm64/lib/Makefile      | 10 +++++-----
 2 files changed, 9 insertions(+), 11 deletions(-)

diff --git a/arch/arm64/include/asm/xor.h b/arch/arm64/include/asm/xor.h
index 7c0320715719..6d689118ee21 100644
--- a/arch/arm64/include/asm/xor.h
+++ b/arch/arm64/include/asm/xor.h
@@ -11,7 +11,7 @@
 #include <asm/hwcap.h>
 #include <asm/neon.h>
 
-#ifdef CONFIG_KERNEL_MODE_NEON
+#if 0
 
 extern struct xor_block_template xor_block_inner_neon __ro_after_init;
 
@@ -64,14 +64,12 @@ static struct xor_block_template xor_block_arm64 = {
 	.do_4   = xor_neon_4,
 	.do_5	= xor_neon_5
 };
+
+#endif
+
 #undef XOR_TRY_TEMPLATES
 #define XOR_TRY_TEMPLATES           \
 	do {        \
 		xor_speed(&xor_block_8regs);    \
 		xor_speed(&xor_block_32regs);    \
-		if (cpu_has_neon()) { \
-			xor_speed(&xor_block_arm64);\
-		} \
 	} while (0)
-
-#endif /* ! CONFIG_KERNEL_MODE_NEON */
diff --git a/arch/arm64/lib/Makefile b/arch/arm64/lib/Makefile
index 68d91c2021f1..4bb3fec58e03 100644
--- a/arch/arm64/lib/Makefile
+++ b/arch/arm64/lib/Makefile
@@ -9,11 +9,11 @@ lib-y		:= clear_user.o delay.o copy_from_user.o		\
 		   memset.o memcmp.o strcmp.o strncmp.o strlen.o	\
 		   strnlen.o strchr.o strrchr.o tishift.o
 
-ifeq ($(CONFIG_KERNEL_MODE_NEON), y)
-obj-$(CONFIG_XOR_BLOCKS)	+= xor-neon.o
-CFLAGS_xor-neon.o		+= $(CC_FLAGS_FPU)
-CFLAGS_REMOVE_xor-neon.o	+= $(CC_FLAGS_NO_FPU)
-endif
+#ifeq ($(CONFIG_KERNEL_MODE_NEON), y)
+#obj-$(CONFIG_XOR_BLOCKS)	+= xor-neon.o
+#CFLAGS_xor-neon.o		+= $(CC_FLAGS_FPU)
+#CFLAGS_REMOVE_xor-neon.o	+= $(CC_FLAGS_NO_FPU)
+#endif
 
 lib-$(CONFIG_ARCH_HAS_UACCESS_FLUSHCACHE) += uaccess_flushcache.o
 
-- 
2.56.0

