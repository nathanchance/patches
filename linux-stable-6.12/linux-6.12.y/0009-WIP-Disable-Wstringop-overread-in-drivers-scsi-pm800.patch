From 6e263b865de4c7218902bd4c48da704d81b6f43e Mon Sep 17 00:00:00 2001
From: Nathan Chancellor <nathan@kernel.org>
Date: Thu, 23 Jul 2026 14:42:46 -0700
Subject: [PATCH 09/16] WIP: Disable -Wstringop-overread in
 drivers/scsi/pm8001/pm80{01,xx}_hwi.c

Signed-off-by: Nathan Chancellor <nathan@kernel.org>
---
 drivers/scsi/pm8001/Makefile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/scsi/pm8001/Makefile b/drivers/scsi/pm8001/Makefile
index bbb51b7312f1..58274ac35877 100644
--- a/drivers/scsi/pm8001/Makefile
+++ b/drivers/scsi/pm8001/Makefile
@@ -8,6 +8,8 @@
 obj-$(CONFIG_SCSI_PM8001) += pm80xx.o
 
 CFLAGS_pm80xx_tracepoints.o := -I$(src)
+CFLAGS_pm80xx_hwi.o := $(call cc-disable-warning,stringop-overread)
+CFLAGS_pm8001_hwi.o := $(call cc-disable-warning,stringop-overread)
 
 pm80xx-y += pm8001_init.o \
 		pm8001_sas.o  \
